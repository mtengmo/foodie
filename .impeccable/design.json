  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "description": "Standard recipe action.",
      "html": "<button class=\"ds-primary\">Save recipe</button>",
      "css": ".ds-primary{min-height:46px;padding:0 17px;border:1px solid transparent;border-radius:9px;background:var(--berry);color:var(--on-accent,#fff);font:700 15px ui-sans-serif,system-ui,sans-serif;cursor:pointer}.ds-primary:hover{filter:brightness(1.08)}.ds-primary:disabled{opacity:.55;cursor:not-allowed}.ds-primary:focus-visible{outline:3px solid var(--ochre);outline-offset:3px}",
      "refersTo": "button-primary"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "description": "Standard recipe action.",
      "html": "<button class=\"ds-secondary\">Export recipes</button>",
      "css": ".ds-secondary{min-height:46px;padding:0 17px;border:1px solid var(--line);border-radius:9px;background:var(--surface);color:var(--ink);font:700 15px ui-sans-serif,system-ui,sans-serif;cursor:pointer}.ds-secondary:focus-visible{outline:3px solid var(--ochre);outline-offset:3px}",
      "refersTo": "button-secondary"
    },
    {
      "name": "Danger Button",
      "kind": "button",
      "description": "Standard recipe action.",
      "html": "<button class=\"ds-danger\">Replace recipes</button>",
      "css": ".ds-danger{min-height:46px;padding:0 17px;border:1px solid transparent;border-radius:9px;background:var(--berry-soft);color:var(--accent-text);font:700 15px ui-sans-serif,system-ui,sans-serif;cursor:pointer}.ds-danger:focus-visible{outline:3px solid var(--ochre);outline-offset:3px}",
      "refersTo": "button-danger"
    },
    {
      "name": "Food Search",
      "kind": "input",
      "description": "Search field with a focus-within accent ring.",
      "html": "<label class=\"ds-search\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><circle cx=\"11\" cy=\"11\" r=\"8\"/><path d=\"m21 21-4.3-4.3\"/></svg><input aria-label=\"Search foods\" placeholder=\"Search foods\" type=\"search\"/></label>",
      "css": ".ds-search{height:58px;border:1px solid var(--line);background:var(--surface);color:var(--muted);border-radius:12px;display:flex;gap:12px;align-items:center;padding:0 16px;box-shadow:var(--shadow)}.ds-search input{width:100%;border:0;outline:0;background:transparent;color:var(--ink);font:15px ui-sans-serif,system-ui,sans-serif}.ds-search input::placeholder{color:var(--muted);opacity:.82}.ds-search:focus-within{border-color:var(--berry);box-shadow:0 0 0 3px color-mix(in srgb,var(--berry) 17%,transparent)}",
      "refersTo": "search"
    },
    {
      "name": "Selected Choice",
      "kind": "chip",
      "description": "Pressed appearance or language choice.",
      "html": "<button class=\"ds-choice\" aria-pressed=\"true\">English</button>",
      "css": ".ds-choice{min-height:46px;padding:0 16px;border:1px solid var(--berry);border-radius:9px;background:var(--berry-soft);color:var(--accent-text);font:700 15px ui-sans-serif,system-ui,sans-serif;cursor:pointer}.ds-choice:focus-visible{outline:3px solid var(--ochre);outline-offset:3px}",
      "refersTo": "choice-active"
    },
    {
      "name": "Navigation",
      "kind": "nav",
      "description": "Sticky-header link treatment.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Main navigation\"><a href=\"#foods\" aria-current=\"page\">Foods</a><a href=\"#recipes\">Recipes</a><a href=\"#settings\">Settings</a></nav>",
      "css": ".ds-nav{display:flex;gap:8px;padding:12px;background:var(--berry);font:600 15px ui-sans-serif,system-ui,sans-serif}.ds-nav a{display:inline-flex;align-items:center;height:46px;padding:0 16px;border-radius:9px;text-decoration:none;color:rgba(255,255,255,.8)}.ds-nav a:hover,.ds-nav a[aria-current]{background:rgba(255,255,255,.15);color:#fff}.ds-nav a:focus-visible{outline:3px solid var(--ochre);outline-offset:3px}"
    },
