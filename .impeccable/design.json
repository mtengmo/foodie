      "html": "<section class=\"ds-panel\"><h2>Potato, boiled</h2><p>Nutrition per 100 g</p><dl><div><dt>Protein</dt><dd>1.8 g</dd></div></dl></section>",
      "css": ".ds-panel{background:var(--surface);color:var(--ink);border-radius:16px;padding:clamp(22px,3vw,38px);box-shadow:var(--shadow);font:15px/1.5 ui-sans-serif,system-ui,sans-serif}.ds-panel h2{font:600 1.65rem/1.1 var(--display);letter-spacing:-.025em;margin:0 0 14px}.ds-panel p,.ds-panel dt{color:var(--muted)}.ds-panel dl div{display:flex;justify-content:space-between;border-bottom:1px solid var(--line);padding:11px 0}.ds-panel dd{font-weight:600;font-variant-numeric:tabular-nums;margin:0}",
      "refersTo": "panel"
    }
