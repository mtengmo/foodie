  "narrative": {
    "northStar": "Nordic Cookbook",
    "overview": "Foodie pairs warm paper and editorial serif headings with compact, practical controls. Its colour comes from berry navigation, botanical selection surfaces and restrained ochre accents. Search, quantities and readable nutrition stay visually prominent.",
    "keyCharacteristics": [
      "Warm paper surfaces with botanical and berry accents.",
      "Editorial headings paired with precise system sans text.",
      "Quiet separators, spacious panels and compact controls.",
      "Responsive layouts with explicit selected and keyboard focus states."
    ],
    "rules": [
